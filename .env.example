# ---------------------------------------------------------------------------
# Environment variables for the Inventory Management System backend.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server port (optional). Hosts like Render inject PORT automatically.
PORT=8000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JSON Web Token signing secret (use a long, random string)
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary credentials (used for staff document/image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS (optional). Comma-separated list of allowed origins.
# Leave unset to allow all origins (development). In production set this to your
# frontend URL, e.g. https://your-frontend.vercel.app
# CORS_ORIGIN=https://your-frontend.vercel.app
